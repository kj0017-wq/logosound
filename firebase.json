{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|ico|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/voice",
        "function": {
          "functionId": "voice",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/editor-exercises",
        "function": {
          "functionId": "editorExercises",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/settings",
        "function": {
          "functionId": "settings",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/patients",
        "function": {
          "functionId": "patientProfiles",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/course-data",
        "function": {
          "functionId": "courseData",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/media-library",
        "function": {
          "functionId": "mediaLibrary",
          "region": "europe-west3"
        }
      },
      {
        "source": "/api/chatgpt",
        "function": {
          "functionId": "chatgpt",
          "region": "europe-west3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
